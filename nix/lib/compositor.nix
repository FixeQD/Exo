{
  lib,
  exoLib,
}: let
  inherit (lib) optionalString;
in {
  hyprland = cfg: ''
    # This file is generated by Exo's Hjem module.
    # Include it from your Hyprland config, for example:
    #   source = $HOME/.config/hypr/exo.conf

    ${optionalString (cfg.sources != []) ''
      ${exoLib.renderHyprlandSources cfg.sources}
    ''}
    ${optionalString (cfg.autostart != []) ''
      ${exoLib.renderHyprlandAutostart cfg.autostart}
    ''}
    ${optionalString (cfg.variables != {}) ''
      ${exoLib.renderHyprlandVariables cfg.variables}

    ''}
    ${optionalString (cfg.environment != {}) ''
      ${exoLib.renderHyprlandEnvironment cfg.environment}
    ''}
    ${optionalString (cfg.bindings != {}) ''
      ${exoLib.renderHyprlandBindings cfg.bindings}
    ''}
    ${cfg.extraConfig}
  '';

  # For compositors Exo has no renderer for.
  custom = cfg: cfg.text;

  niri = cfg: ''
    // This file is generated by Exo's Hjem module.
    // Include it from your Niri config, for example:
    //   include "$HOME/.config/niri/exo.kdl"

    ${optionalString (cfg.autostart != []) ''
      ${exoLib.renderNiriAutostart cfg.autostart}
    ''}
    ${optionalString (cfg.bindings != "") (
      if cfg.wrapBindings
      then ''
        binds {
        ${cfg.bindings}
        }
      ''
      else cfg.bindings
    )}
    ${cfg.extraConfig}
  '';
}
