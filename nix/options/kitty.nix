{
  lib,
  config,
  exoLib,
  ...
}: let
  inherit (lib) concatStringsSep mkIf mkOption types;

  cfg = config.exo.kitty;

  kittyConfig = ''
    # Generated by Exo's Hjem module. Do not edit this file in ~/.config.
    ${concatStringsSep "\n" (map (file: "include ${file}") cfg.includes)}
    font_family ${cfg.fontFamily}
    window_padding_width ${toString cfg.windowPadding}
    shell ${cfg.shell}
    confirm_os_window_close ${
      if cfg.confirmOsWindowClose
      then "1"
      else "0"
    }

    ${exoLib.renderKittyKeybindings cfg.keybindings}
    ${cfg.extraConfig}
  '';
in {
  options.exo.kitty = {
    enable = mkOption {
      type = types.bool;
      default = false;
      description = ''
        Generate a Kitty configuration and install Kitty.
      '';
    };

    directory = mkOption {
      type = types.str;
      default = "kitty";
      description = "Directory below the XDG config home for the generated configuration.";
    };

    fileName = mkOption {
      type = types.str;
      default = "kitty.conf";
      description = "File name of the generated Kitty configuration.";
    };

    includes = mkOption {
      type = types.listOf types.str;
      default = [
        "colors.conf"
      ];
      description = "Files sourced from the top of the generated configuration.";
    };

    fontFamily = mkOption {
      type = types.str;
      default = "JetBrainsMono Nerd Font";
    };

    windowPadding = mkOption {
      type = types.ints.positive;
      default = 15;
    };

    shell = mkOption {
      type = types.str;
      default = "fish";
    };

    confirmOsWindowClose = mkOption {
      type = types.bool;
      default = false;
    };

    keybindings = mkOption {
      type = types.attrsOf types.str;
      default = {
        page_up = "scroll_page_up";
        page_down = "scroll_page_down";
        "ctrl+plus" = "change_font_size all +1";
        "ctrl+equal" = "change_font_size all +1";
        "ctrl+kp_add" = "change_font_size all +1";
        "ctrl+minus" = "change_font_size all -1";
        "ctrl+underscore" = "change_font_size all -1";
        "ctrl+kp_subtract" = "change_font_size all -1";
        "ctrl+0" = "change_font_size all 0";
        "ctrl+kp_0" = "change_font_size all 0";
      };
    };

    extraConfig = mkOption {
      type = types.lines;
      default = "";
    };
  };

  config = mkIf cfg.enable {
    xdg.config.files."${cfg.directory}/${cfg.fileName}".text = kittyConfig;
  };
}
