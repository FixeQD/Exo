# Matugen configuration and the templates it renders.
{
  lib,
  config,
  exoConfig,
  exoLib,
  ...
}: let
  inherit
    (lib)
    concatStringsSep
    listToAttrs
    mapAttrs'
    mapAttrsToList
    mkOption
    optionalAttrs
    types
    ;

  cfg = config.exo.matugen;
  xdgConfigDir = exoLib.homeRelative config.directory config.xdg.config.directory;
  xdgDataDir = exoLib.homeRelative config.directory config.xdg.data.directory;

  matugenConfig = ''
    # Generated by Exo's Hjem module. Do not edit this file in ~/.config.
    [config.wallpaper]
    command = ${exoLib.tomlString cfg.wallpaperCommand}
    set = ${exoLib.boolToToml cfg.setWallpaper}

    ${concatStringsSep "\n" (mapAttrsToList exoLib.renderMatugenTemplate cfg.templates)}

    ${cfg.extraConfig}
  '';

  templateModule = types.submodule {
    options = {
      inputPath = mkOption {
        type = types.str;
        description = "Path, relative to the Matugen config directory, of the input template.";
      };
      outputPath = mkOption {
        type = types.str;
        description = "Path where Matugen writes the generated output.";
      };
      postHook = mkOption {
        type = types.nullOr types.str;
        default = null;
        description = "Optional command run by Matugen after rendering this template.";
      };
    };
  };
in {
  options.exo.matugen = {
    directory = mkOption {
      type = types.str;
      default = "matugen";
      description = "Directory below the XDG config home for the generated configuration and templates.";
    };

    templatesDirectory = mkOption {
      type = types.str;
      default = "templates";
      description = "Directory below exo.matugen.directory holding the input templates.";
    };

    configFileName = mkOption {
      type = types.str;
      default = "config.toml";
      description = "File name of the generated Matugen configuration.";
    };

    wallpaperCommand = mkOption {
      type = types.str;
      default = "awww img {{ image }} --transition-type simple";
      description = ''
        Command Matugen runs to set the wallpaper. Matugen substitutes
        `{{ image }}` with the image path, so the whole command line belongs
        here.
      '';
    };

    setWallpaper = mkOption {
      type = types.bool;
      default = true;
    };

    templates = mkOption {
      type = types.attrsOf templateModule;
      default =
        {
          ignis = {
            inputPath = "./${cfg.templatesDirectory}/colors.scss";
            outputPath = "${xdgConfigDir}/${config.exo.ignis.directory}/colors.scss";
          };
          hypr = {
            inputPath = "./${cfg.templatesDirectory}/colors.conf";
            outputPath = "${xdgConfigDir}/${config.exo.compositor.hyprland.directory}/colors.conf";
          };
          hyprlock = {
            inputPath = "./${cfg.templatesDirectory}/hyprlock.conf";
            outputPath = "${xdgConfigDir}/${config.exo.compositor.hyprland.directory}/hyprlock.conf";
          };
          gtk3 = {
            inputPath = "./${cfg.templatesDirectory}/gtk-colors.css";
            outputPath = "${xdgConfigDir}/gtk-3.0/colors.css";
            postHook = "gsettings set org.gnome.desktop.interface gtk-theme \"\"; gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3";
          };
          gtk4 = {
            inputPath = "./${cfg.templatesDirectory}/gtk-colors.css";
            outputPath = "${xdgConfigDir}/gtk-4.0/colors.css";
          };
          qt5ct = {
            inputPath = "./${cfg.templatesDirectory}/qt-colors.conf";
            outputPath = "${xdgConfigDir}/qt5ct/colors/matugen.conf";
          };
          qt6ct = {
            inputPath = "./${cfg.templatesDirectory}/qt-colors.conf";
            outputPath = "${xdgConfigDir}/qt6ct/colors/matugen.conf";
          };
          vscode = {
            inputPath = "./${cfg.templatesDirectory}/hyprlunavsc.json";
            outputPath = "~/.vscode/extensions/hyprluna.hyprluna-theme-1.0.2/themes/hyprluna.json";
          };
          qt-color-scheme = {
            inputPath = "./${cfg.templatesDirectory}/Matugen.colors";
            outputPath = "${xdgDataDir}/color-schemes/Matugen.colors";
          };
        }
        // optionalAttrs config.exo.kitty.enable {
          kitty = {
            inputPath = "./${cfg.templatesDirectory}/kitty.conf";
            outputPath = "${xdgConfigDir}/${config.exo.kitty.directory}/colors.conf";
            postHook = "pkill -SIGUSR1 kitty";
          };
        };
    };

    templateSources = mkOption {
      type = types.attrsOf types.path;
      default = listToAttrs (map (name: {
          inherit name;
          value = "${exoConfig}/share/exo/matugen/templates/${name}";
        }) [
          "colors.scss"
          "colors.conf"
          "hyprlock.conf"
          "kitty.conf"
          "gtk-colors.css"
          "qt-colors.conf"
          "hyprlunavsc.json"
          "Matugen.colors"
        ]);
      description = "Matugen input templates, keyed by file name inside the Matugen template directory.";
    };

    extraConfig = mkOption {
      type = types.lines;
      default = "";
    };
  };

  config = lib.mkIf config.exo.enable {
    xdg.config.files = lib.mkMerge [
      {
        "${cfg.directory}/${cfg.configFileName}" = {
          text = matugenConfig;
          type = "copy";
        };
      }
      (mapAttrs' (name: source: {
          name = "${cfg.directory}/${cfg.templatesDirectory}/${name}";
          value = {
            inherit source;
            type = "copy";
          };
        })
        cfg.templateSources)
    ];
  };
}
